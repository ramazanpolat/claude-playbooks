-- title: SRE in a sandbox
-- description: For operations work in a microVM: the Cloudflare docs, runbooks with doc-coauthoring, and read-only kubectl.
-- min-cpb: 4.0.0
-- create-with: SANDBOX

ALTER PLAYBOOK
  ADD MCP SERVER cloudflare-docs URL 'https://docs.mcp.cloudflare.com/mcp'
  ADD SKILL doc-coauthoring FROM 'github:anthropics/skills' SUBDIR 'skills/doc-coauthoring'
  ALLOW TOOL 'Bash(kubectl get *)' 'Bash(kubectl describe *)' 'Bash(kubectl logs *)'
  DENY TOOL 'Bash(kubectl delete *)' 'Bash(kubectl apply *)';
