-- title: Another model backend
-- description: A playbook for a model backend behind your router (GLM here): it runs on your router's account, with a login of its own and a /model list of its own.
-- min-cpb: 4.2.0
-- needs: an account for your router, such as cpb CREATE ACCOUNT router SET provider = 'gateway', base_url = 'http://localhost:4000/v1', auth = 'none', model = 'glm-5.3'; then cpb play router-glm --account router

ALTER PLAYBOOK
  ADD MCP SERVER context7 COMMAND 'npx' ARGS '-y' '@upstash/context7-mcp'
  ADD MODEL 'glm-5.3' LABEL 'GLM 5.3'
  ADD MODEL 'glm-5.3-flash' LABEL 'GLM 5.3 Flash' BEHAVES AS 'claude-sonnet-5'
  SET model_picker.mode = 'only'
  SET login = 'isolated';
