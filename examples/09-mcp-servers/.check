# The server's config holds a placeholder, never the secret; the manifest holds the reference.
cfg="$HOME/.claude-playbooks/researcher"
grep -q '"Authorization": "${CPB_MCP_SENTRY_H_AUTHORIZATION_' "$cfg/.claude.json"
grep -q 'keychain:pilot/sentry-auth' "$cfg/.playbook"
cpb EXPLAIN PLAYBOOK researcher | grep -q sentry
# DROP MCP SERVER removes the server and forgets its reference.
cpb ALTER PLAYBOOK researcher DROP MCP SERVER sentry
if grep -q '"sentry"' "$cfg/.claude.json"; then echo "sentry still configured"; exit 1; fi
if grep -q 'keychain:pilot/sentry-auth' "$cfg/.playbook"; then echo "reference kept"; exit 1; fi
grep -q '"files"' "$cfg/.claude.json"
