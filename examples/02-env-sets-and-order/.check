# Place a set without restating the list: take thinking out, put it first.
cpb ALTER PLAYBOOK work DROP ENV thinking
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["router"], e'
cpb ALTER PLAYBOOK work ADD ENV thinking FIRST
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["thinking","router"], e'
# Unset the playbook's own model: router's value decides again.
cpb ALTER PLAYBOOK work UNSET VAR ANTHROPIC_MODEL
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; v=json.load(sys.stdin)["vars"]; assert all(x["key"]!="ANTHROPIC_MODEL" for x in v), v'
# Swap one set for another in place: REPLACE ENV keeps its position, and a
# second run changes nothing (the old set is gone, the new one attached).
cpb CREATE OR REPLACE ENV fast SET ANTHROPIC_MODEL=glm-5.3-flash
cpb ALTER PLAYBOOK work REPLACE ENV router WITH fast
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["thinking","fast"], e'
cpb ALTER PLAYBOOK work REPLACE ENV router WITH fast | grep -q unchanged
cpb ALTER PLAYBOOK work REPLACE ENV fast WITH router
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["thinking","router"], e'
