env="$HOME/.claude-playbooks/work/.fake-claude/launch-env"
# The launch the README shows: the playbook's own value wins over both sets.
cpb run work
grep -qx 'MAX_THINKING_TOKENS=16000' "$env"
grep -qx 'EDITOR=vim' "$env"
# Place a set without restating the list: take thinking out, put it first.
cpb ALTER PLAYBOOK work DROP ENV thinking
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["tools"], e'
cpb ALTER PLAYBOOK work ADD ENV thinking FIRST
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["thinking","tools"], e'
# Unset the playbook's own value: the later set, tools, decides again.
cpb ALTER PLAYBOOK work UNSET VAR MAX_THINKING_TOKENS
cpb run work
grep -qx 'MAX_THINKING_TOKENS=4000' "$env"
# Swap one set for another in place: REPLACE ENV keeps its position, and a
# second run changes nothing (the old set is gone, the new one attached).
cpb CREATE OR REPLACE ENV fast SET MAX_THINKING_TOKENS=2000
cpb ALTER PLAYBOOK work REPLACE ENV tools WITH fast
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["thinking","fast"], e'
cpb ALTER PLAYBOOK work REPLACE ENV tools WITH fast | grep -q unchanged
cpb ALTER PLAYBOOK work REPLACE ENV fast WITH tools
cpb SHOW PLAYBOOK work --json | python3 -c 'import json,sys; e=json.load(sys.stdin)["envs"]; assert e==["thinking","tools"], e'
# An env set may state a route only whole, its address with its key: an
# address alone refuses the launch, naming the set.
cpb CREATE OR REPLACE ENV routed SET ANTHROPIC_BASE_URL=http://localhost:8080/v1
cpb ALTER PLAYBOOK work ADD ENV routed
if cpb run work 2> "$HOME/routed.err"; then echo "a routed env set launched"; exit 1; fi
grep -q 'ENV routed states an address with no key' "$HOME/routed.err"
cpb ALTER PLAYBOOK work DROP ENV routed
cpb DROP ENV routed
