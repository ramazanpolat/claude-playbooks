# The built-in form needs nothing installed.
cpb "SELECT name, envs FROM PLAYBOOKS" | grep -q 'beta  *router'
cpb "SELECT playbook, key, effective FROM VARS" --json | grep -q '"key": "MODEL"'
cpb EXPLAIN SELECT name FROM ENVS | grep -q 'engine: built in'
# Anything else goes to clickhouse-local, when it is installed.
if command -v clickhouse >/dev/null 2>&1 || command -v ch >/dev/null 2>&1; then
  test "$(cpb "SELECT count() FROM VARS WHERE effective FORMAT TSV")" -ge 2
fi
