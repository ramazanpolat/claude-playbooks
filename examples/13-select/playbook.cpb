-- Something to query: two playbooks, one on an env set with its own variable.
-- The router's own key goes with its address (see 02 and 04).
ALTER DEFAULTS SET secret_helper = 'cpb-secret-file';
CREATE OR REPLACE ENV router SET ANTHROPIC_BASE_URL=http://localhost:8080/v1 SET ANTHROPIC_AUTH_TOKEN FROM 'file:router-token';

CREATE PLAYBOOK IF NOT EXISTS alpha SET launcher = '';
CREATE PLAYBOOK IF NOT EXISTS beta SET launcher = '', login = 'isolated';
ALTER PLAYBOOK beta USE ENV router SET VAR MODEL=glm;
