p="$HOME/.claude-playbooks"
grep -qx 'isolated_login = true' "$p/other-account/.playbook"
grep -qx 'isolated_login = true' "$p/scratch/.playbook"
cpb SHOW PLAYBOOK scratch --json | python3 -c 'import json,sys; v=json.load(sys.stdin); assert v["isolated_login"] is True and v["sandbox"]["always"] is False, v'
cpb EXPLAIN PLAYBOOK scratch | grep -q '^Login: isolated'
cpb SHOW CREATE PLAYBOOK scratch | grep -qx '  SET ISOLATED LOGIN;'
# A login of its own blocks UNSET: a shared launch would copy it over the
# machine's login. (A made-up store, not a real grant.)
printf '{"claudeAiOauth":{"accessToken":"example-not-a-token"}}' > "$p/scratch/.credentials.json"
if cpb "ALTER PLAYBOOK scratch UNSET ISOLATED LOGIN" 2> "$HOME/unset.err"; then echo "UNSET accepted"; exit 1; fi
grep -q 'has a login of its own' "$HOME/unset.err"
# Logged out, it goes through; the next launch links the shared login again.
rm "$p/scratch/.credentials.json"
cpb "ALTER PLAYBOOK scratch UNSET ISOLATED LOGIN"
if grep -q 'isolated_login' "$p/scratch/.playbook"; then echo "isolated_login left"; exit 1; fi
