p="$HOME/.claude-playbooks"
# The CLAUDE.md cpb writes imports nothing: no line of it starts with @.
if grep -q '^@' "$p/routed/CLAUDE.md"; then echo "CLAUDE.md imports something"; exit 1; fi
# The route comes from the account, and the login is the playbook's own.
cpb EXPLAIN PLAYBOOK routed | grep -q "Account: router (gateway http://localhost:8080/v1, none; the playbook's first)"
cpb SHOW PLAYBOOK routed --json | python3 -c 'import json,sys; v=json.load(sys.stdin); assert v["login"] == "isolated" and v["accounts"] == ["router"], v'
# A launch carries the account's address and model, and no Anthropic
# credential, even one the shell exports.
ANTHROPIC_API_KEY=from-the-shell CLAUDE_CODE_OAUTH_TOKEN=from-the-shell cpb run routed
env="$p/routed/.fake-claude/launch-env"
grep -qx 'ANTHROPIC_BASE_URL=http://localhost:8080/v1' "$env"
grep -qx 'ANTHROPIC_DEFAULT_MODEL=glm-5.3' "$env"
if grep -q 'from-the-shell' "$env"; then echo "a shell credential reached the route"; exit 1; fi
