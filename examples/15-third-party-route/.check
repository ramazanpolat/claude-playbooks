p="$HOME/.claude-playbooks"
# The CLAUDE.md cpb writes imports nothing: no line of it starts with @.
if grep -q '^@' "$p/routed/CLAUDE.md"; then echo "CLAUDE.md imports something"; exit 1; fi
# The route comes from the env set, the login is the playbook's own, and the
# Anthropic credentials are blocked.
cpb EXPLAIN PLAYBOOK routed | grep -q 'ANTHROPIC_BASE_URL'
cpb SHOW PLAYBOOK routed --json | python3 -c 'import json,sys; v=json.load(sys.stdin); assert v["login"] == "isolated" and v["envs"] == ["router"], v; assert {x["key"] for x in v["vars"] if x.get("blocked")} >= {"ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN"}, v["vars"]'
