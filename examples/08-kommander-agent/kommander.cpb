-- kommander.cpb: Kommander as a plugin and the main-thread agent, on bare.
-- The kommander-playbook repository is both the marketplace and the plugin.
-- It is private: point the path at your checkout. With access to it, the
-- same clause can read FROM 'github:ramazanpolat/kommander-playbook'.
-- Agent Kommander is moving to its own repository, agent-kommander; this
-- source changes to that marketplace when it ships.
INCLUDE 'bare.cpb';

ALTER PLAYBOOK
  ADD MARKETPLACE kommander FROM '~/path/to/kommander-playbook'
  ADD PLUGIN kommander@kommander
  SET AGENT 'kommander'
  ALLOW TOOL 'Bash(kommander-helper *)'
  SET STATUSLINE 'bash ~/path/to/kommander-playbook/hooks/statusline.sh' REFRESH 10;
