-- kommander.cpb: Kommander as a plugin and the main-thread agent, on bare.
-- The kommander-playbook repository is both the marketplace and the plugin.
-- To use a local checkout instead (a branch under development), write
--   ADD MARKETPLACE kommander FROM '~/DEV/kommander-playbook'
INCLUDE 'bare.cpb';

ALTER PLAYBOOK kommander-agent
  ADD MARKETPLACE kommander FROM 'github:ramazanpolat/kommander-playbook'
  ADD PLUGIN kommander@kommander
  SET AGENT 'kommander';
