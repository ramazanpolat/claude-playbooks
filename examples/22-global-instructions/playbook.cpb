-- Claude Code loads the CLAUDE.md of every ancestor of the working
-- directory, and ~/.claude is one: without this setting, the machine's own
-- ~/.claude/CLAUDE.md and rules would load into every playbook under $HOME.
-- A new playbook keeps them out (global_instructions = 'excluded', the default).
CREATE PLAYBOOK IF NOT EXISTS focused SET launcher = '';

-- One that wants the machine's instructions says so.
CREATE PLAYBOOK IF NOT EXISTS familiar SET launcher = '' SET global_instructions = 'inherited';
