-- A playbook that runs in the OpenShell sandbox backend, routed to a model
-- router on this machine, which the sandbox reaches as
-- host.openshell.internal.
CREATE OR REPLACE ENV router
  DESCRIBE 'A model router on this machine'
  SET ANTHROPIC_BASE_URL=http://localhost:8080/v1;

CREATE PLAYBOOK IF NOT EXISTS box NO ALIAS;
-- Every launch of box runs in a sandbox (SET SANDBOX, which also isolates its
-- login), with OpenShell as the backend and one more host allowed out.
ALTER PLAYBOOK box
  USE ENV router
  SET SANDBOX
  SET SANDBOX backend=openshell allow_net=api.github.com;
