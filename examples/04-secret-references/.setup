# The secret, stored the way the sample helper reads it: one file, mode 600.
# A placeholder here; for real, write the value without echoing it.
mkdir -p "$HOME/.config/cpb-secrets" && chmod 700 "$HOME/.config/cpb-secrets"
(umask 077 && printf '%s' 'placeholder-router-token' > "$HOME/.config/cpb-secrets/router-token")
