p="$HOME/.claude-playbooks/routed"
# The reference is stored, never the value.
cpb SHOW ENV router | grep -q "file:router-token"
if grep -rq 'placeholder-router-token' "$HOME/.claude-playbooks"; then echo "the value reached a file"; exit 1; fi
# A launch goes through the helper, and only that launch sees the value.
cpb run routed
grep -qx 'ANTHROPIC_AUTH_TOKEN=placeholder-router-token' "$p/.fake-claude/launch-env"
# A reference the helper cannot resolve is refused when written.
if cpb ALTER ENV router SET OTHER_TOKEN FROM 'file:missing' 2> "$HOME/missing.err"; then echo "an unresolvable reference was stored"; exit 1; fi
grep -q 'no file for its reference' "$HOME/missing.err"
# No helper: the reference stays, and nothing can resolve it.
cpb ALTER DEFAULTS DELETE secret_helper
cpb SHOW DEFAULTS --json | python3 -c 'import json,sys; d=json.load(sys.stdin); assert d["secret_helper"] is None, d'
