-- A playbook whose status line is a host (statusmux), composed from
-- panels: a clock, the model's name, and a heartbeat that runs on every
-- render without showing anything. cpb writes the panel manifests; the
-- layout (statusline.toml) stays yours.
CREATE PLAYBOOK IF NOT EXISTS barred NO ALIAS NO PILOT PROFILE;

ALTER PLAYBOOK barred
  SET STATUSLINE '"$HOME/.local/bin/statusmux" render' REFRESH 10
  ADD PANEL local.clock EXEC 'date +%H:%M' ALIGN RIGHT PRIORITY 20
  ADD PANEL local.model TEMPLATE '{model.display_name}'
  ADD PANEL local.beat OBSERVE 'sh ${PANEL_DIR}/beat.sh' EVERY 10000;
