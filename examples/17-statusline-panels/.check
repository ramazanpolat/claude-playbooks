p="$HOME/.claude-playbooks/barred"
d="$p/statusline.d/local"
for f in clock model beat; do head -1 "$d/$f.toml" | grep -q '^# Written by cpb'; done
grep -qx 'type = "observe"' "$d/beat.toml"
grep -qx 'every_ms = 10000' "$d/beat.toml"
cpb SHOW PLAYBOOK barred --json | python3 -c 'import json,sys; p=json.load(sys.stdin)["panels"]; assert [x["panel"] for x in p] == ["local.beat", "local.clock", "local.model"] and all(x["cpb"] for x in p), p'
cpb "SELECT panel, type FROM PANELS --json" | python3 -c 'import json,sys; r=json.load(sys.stdin); assert len(r) == 3, r'
# The host holds the slot, so EXPLAIN has no "do not render" note.
cpb EXPLAIN PLAYBOOK barred | grep -q '^Panels: 3 (local.beat, local.clock, local.model)$'
# The layout file is the pilot's: cpb never writes it.
test ! -e "$p/statusline.toml"
# DROP PANEL removes one; FROM STATUSLINE refuses to adopt the host itself.
cpb "ALTER PLAYBOOK barred DROP PANEL local.clock"
test ! -e "$d/clock.toml"
if cpb "ALTER PLAYBOOK barred ADD PANEL local.bar FROM STATUSLINE" 2>/dev/null; then echo "adopted the host"; exit 1; fi
