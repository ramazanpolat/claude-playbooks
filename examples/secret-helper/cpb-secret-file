#!/bin/sh
# cpb-secret-file: a sample secret helper for cpb (cpb's helper interface,
# SPEC.md, "Secrets"). It resolves file:<name>
# references from files under ${CPB_SECRET_FILES:-$HOME/.config/cpb-secrets},
# one value per file, and never prints a value.
#
#   cpb-secret-file --check KEY=REF ...       exit 0 when every reference resolves
#   cpb-secret-file KEY=REF ... -- cmd [args]  run cmd with each KEY set to its value
#
# Store a value without it reaching your shell history:
#   mkdir -p ~/.config/cpb-secrets && chmod 700 ~/.config/cpb-secrets
#   (umask 077 && read -r v && printf '%s' "$v" > ~/.config/cpb-secrets/router-token)
set -eu
dir=${CPB_SECRET_FILES:-$HOME/.config/cpb-secrets}

# path_of <reference>: the file a reference names, or a refusal.
path_of() {
  case $1 in
  file:*) name=${1#file:} ;;
  *) echo "cpb-secret-file reads file:<name> references, not ${1%%:*}:" >&2; exit 3 ;;
  esac
  case $name in
  "" | */* | .*) echo "cpb-secret-file: a file reference names one file under $dir" >&2; exit 3 ;;
  esac
  printf '%s/%s' "$dir" "$name"
}

if [ "${1:-}" = --check ]; then
  shift
  for pair in "$@"; do
    p=$(path_of "${pair#*=}")
    [ -f "$p" ] && [ -r "$p" ] || { echo "cpb-secret-file: ${pair%%=*}: no file for its reference under $dir" >&2; exit 4; }
  done
  exit 0
fi

while [ $# -gt 0 ] && [ "$1" != -- ]; do
  key=${1%%=*}
  p=$(path_of "${1#*=}")
  [ -f "$p" ] && [ -r "$p" ] || { echo "cpb-secret-file: $key: no file for its reference under $dir" >&2; exit 4; }
  # Trailing newlines are dropped, so a file written with echo works too.
  value=$(cat "$p")
  export "$key=$value"
  shift
done
usage() { echo "usage: cpb-secret-file KEY=REF ... -- command [args]" >&2; exit 2; }
[ "${1:-}" = -- ] || usage
shift
[ $# -gt 0 ] || usage
exec "$@"
