# The two tokens, stored the way the sample helper reads them: one file each,
# mode 600. Placeholders here; for real, write each value without echoing it
# (cpb-secret-file's header shows how).
mkdir -p "$HOME/.config/cpb-secrets" && chmod 700 "$HOME/.config/cpb-secrets"
(umask 077 && printf '%s' 'placeholder-work-token' > "$HOME/.config/cpb-secrets/claude-token-work")
(umask 077 && printf '%s' 'placeholder-personal-token' > "$HOME/.config/cpb-secrets/claude-token-personal")
