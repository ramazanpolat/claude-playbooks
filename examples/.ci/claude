#!/bin/sh
# A stand-in for `claude` in the examples check: it answers the
# `claude plugin` and `claude mcp` commands cpb runs, keeping its state in the playbook's
# config directory, and records any other launch. No network, no model.
st="$CLAUDE_CONFIG_DIR/.fake-claude"
mkdir -p "$st"
case "$*" in
  "plugin marketplace list --json") cat "$st/markets.json" 2>/dev/null || echo "[]" ;;
  "plugin list --json") cat "$st/plugins.json" 2>/dev/null || echo "[]" ;;
  "plugin marketplace add "*)
    src=$4
    if [ -d "$src" ]; then
      name=$(sed -n 's/^ *"name": *"\([^"]*\)".*/\1/p' "$src/.claude-plugin/marketplace.json" | head -1)
      entry="{\"name\":\"$name\",\"source\":\"directory\",\"path\":\"$src\"}"
    else
      # FAKE_MARKETS maps a source to the name it declares: "owner/repo=name ..."
      name=$(printf '%s\n' $FAKE_MARKETS | sed -n "s|^$src=||p" | head -1)
      entry="{\"name\":\"$name\",\"source\":\"github\",\"repo\":\"$src\"}"
    fi
    old=$(cat "$st/markets.json" 2>/dev/null || echo "[]")
    if [ "$old" = "[]" ]; then echo "[$entry]"; else echo "${old%]},$entry]"; fi > "$st/markets.json" ;;
  "plugin install "*)
    old=$(cat "$st/plugins.json" 2>/dev/null || echo "[]")
    entry="{\"id\":\"$3\",\"scope\":\"user\",\"enabled\":true}"
    if [ "$old" = "[]" ]; then echo "[$entry]"; else echo "${old%]},$entry]"; fi > "$st/plugins.json"
    echo '{"command":"install","outcome":"ok"}' ;;
  "plugin uninstall "*|"plugin marketplace remove "*)
    # Forget the plugin (by id) or the marketplace (by name).
    python3 - "$st" "$@" <<'PYEOF'
import json, sys
st, args = sys.argv[1], sys.argv[2:]
if args[1] == "uninstall":
    path, key, value = st + "/plugins.json", "id", args[2]
else:
    path, key, value = st + "/markets.json", "name", args[3]
try:
    items = json.load(open(path))
except FileNotFoundError:
    items = []
json.dump([i for i in items if i.get(key) != value], open(path, "w"))
if args[1] == "uninstall":
    print('{"command":"uninstall","outcome":"ok"}')
PYEOF
    ;;
  "mcp add-json "*|"mcp remove "*)
    # The servers live where Claude Code keeps them: .claude.json mcpServers.
    python3 - "$CLAUDE_CONFIG_DIR/.claude.json" "$@" <<'PYEOF'
import json, sys
path, verb, name = sys.argv[1], sys.argv[3], sys.argv[4]
try:
    root = json.load(open(path))
except FileNotFoundError:
    root = {}
servers = root.setdefault("mcpServers", {})
if verb == "add-json":
    if name in servers:
        sys.exit("MCP server %s already exists in user config" % name)
    servers[name] = json.loads(sys.argv[5])
elif servers.pop(name, None) is None:
    sys.exit("No MCP server named " + name)
json.dump(root, open(path, "w"), indent=2)
PYEOF
    ;;
  plugin*|mcp*) echo "fake claude: not handled: $*" >&2; exit 2 ;;
  *) env > "$CLAUDE_CONFIG_DIR/.fake-claude/launch-env" ;;
esac
