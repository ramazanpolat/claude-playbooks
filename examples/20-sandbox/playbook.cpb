-- A playbook whose every launch runs in a Docker Sandbox (sbx), with one more
-- host allowed out and one more directory mounted, read-only.
CREATE PLAYBOOK IF NOT EXISTS box NO ALIAS;
-- SET SANDBOX on its own sandboxes every launch, and isolates the login; the
-- keyed form sets the [sandbox] table's own keys.
ALTER PLAYBOOK box
  SET SANDBOX
  SET SANDBOX backend=sbx mounts=~/shared-libs:ro allow_net=api.github.com;
