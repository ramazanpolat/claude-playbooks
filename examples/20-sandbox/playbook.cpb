-- A playbook whose every launch runs in a Docker Sandbox (sbx), with one more
-- host allowed out and one more directory mounted, read-only.
CREATE PLAYBOOK IF NOT EXISTS box SET launcher = '';
-- sandbox.always = true sandboxes every launch; a sandbox shares no login
-- with the machine, so the login is isolated too. The other sandbox.<key>
-- properties are the [sandbox] table's own keys.
ALTER PLAYBOOK box
  SET sandbox.always = true, login = 'isolated'
  SET sandbox.backend = 'sbx', sandbox.mounts = ['~/shared-libs:ro'], sandbox.allow_net = ['api.github.com'];
