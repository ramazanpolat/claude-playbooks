python3 - "$HOME/.claude-playbooks/reviewer/settings.json" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
assert s["permissions"]["allow"] == ["Bash(git diff *)", "Bash(go test *)"], s
assert s["permissions"]["deny"] == ["Read(~/.ssh/**)"], s
assert s["statusLine"] == {"type": "command", "command": "echo reviewer"}, s
assert s["model"] == "claude-opus-5-5", s
PY
cpb EXPLAIN PLAYBOOK reviewer | grep -q 'Tools: allow'
cpb "ALTER PLAYBOOK reviewer UNSET TOOL 'Read(~/.ssh/**)' UNSET STATUSLINE UNSET MODEL"
python3 - "$HOME/.claude-playbooks/reviewer/settings.json" <<'PY'
import json, sys
s = json.load(open(sys.argv[1]))
assert not s.get("permissions", {}).get("deny"), s
assert s["permissions"]["allow"] == ["Bash(git diff *)", "Bash(go test *)"], s
assert "statusLine" not in s and "model" not in s, s
PY
