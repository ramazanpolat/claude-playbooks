-- Claude Code settings with no CLI of their own: tool permissions, the
-- status line and the default model, written into the playbook's
-- settings.json. Every other key in that file is kept.
CREATE PLAYBOOK IF NOT EXISTS reviewer NO LAUNCHER;

ALTER PLAYBOOK reviewer
  ALLOW TOOL 'Bash(git diff *)' 'Bash(go test *)'
  DENY TOOL 'Read(~/.ssh/**)'
  SET STATUSLINE 'echo reviewer' REFRESH 10
  SET MODEL 'claude-opus-5-5';
