s="$HOME/.claude-playbooks/barred/settings.json"
# A new playbook has no status line, so IF UNSET applied.
python3 -c 'import json,sys; s=json.load(open(sys.argv[1]))["statusLine"]; assert s == {"type": "command", "command": "date +%H:%M", "refreshInterval": 10}, s' "$s"
# Your own bar: a plain SET statusline always applies.
cpb "ALTER PLAYBOOK barred SET statusline.command = 'echo mine'"
# Offering again changes nothing now: the slot is set.
cpb "ALTER PLAYBOOK barred SET IF UNSET statusline.command = 'date +%H:%M', statusline.refresh = 10" | grep -q 'unchanged'
python3 -c 'import json,sys; s=json.load(open(sys.argv[1]))["statusLine"]; assert s["command"] == "echo mine", s' "$s"
# SHOW CREATE writes the status line as it is, not the condition.
cpb SHOW CREATE PLAYBOOK barred | grep -q "SET statusline.command = 'echo mine', statusline.refresh = 10"
if cpb SHOW CREATE PLAYBOOK barred | grep -q 'IF UNSET'; then echo "SHOW CREATE wrote IF UNSET"; exit 1; fi
# Any property, whole or not at all: with a model set, neither key changes,
# and the line names the key that was set.
cpb "ALTER PLAYBOOK barred SET model = 'mine'" > /dev/null
cpb "ALTER PLAYBOOK barred SET IF UNSET model = 'claude-opus-5-5', agent = 'reviewer'" | grep -q 'model is set; SET IF UNSET changed nothing'
python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); assert s["model"] == "mine" and "agent" not in s, s' "$s"
cpb "ALTER PLAYBOOK barred RESET model" > /dev/null
cpb "ALTER PLAYBOOK barred SET IF UNSET model = 'claude-opus-5-5', agent = 'reviewer'" > /dev/null
python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); assert s["model"] == "claude-opus-5-5" and s["agent"] == "reviewer", s' "$s"
# A key whose default is a value is never unset, so SET IF UNSET refuses it.
if cpb "ALTER PLAYBOOK barred SET IF UNSET login = 'isolated'" 2> "$HOME/iu.err"; then echo "SET IF UNSET login accepted"; exit 1; fi
grep -q 'never unset; use SET' "$HOME/iu.err"
# CREATE OR ALTER takes it too: on a playbook that exists it is judged.
cpb "CREATE OR ALTER PLAYBOOK barred SET IF UNSET model = 'other'" | grep -q 'model is set'
