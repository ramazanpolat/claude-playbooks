#!/bin/sh
# A stand-in secret helper for the site's checks: every reference is present,
# and a launch gets a placeholder in place of the secret. It never holds a real
# one. cpb calls it as `helper --check VAR=REF ...` and as
# `helper VAR=REF ... -- command ...`.
if [ "$1" = --check ]; then exit 0; fi
while [ $# -gt 0 ] && [ "$1" != -- ]; do export "${1%%=*}=resolved-placeholder"; shift; done
shift
exec "$@"
